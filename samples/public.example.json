{
  "samples": [
    {
      "id": "public-pdf-quality-example",
      "path": "samples/public/public-pdf-quality-example.pdf",
      "category": "report",
      "features": ["tables", "multi_column", "figures", "headers_footers"],
      "engine": "mineru",
      "_comment": "expected_markdown and expected_tables are optional. Supply them to score fidelity (word-level edit distance for text, TEDS for tables); omit them and the sample is reported as unscored rather than as perfect.",
      "expected_markdown": "samples/public/public-pdf-quality-example.expected.md",
      "expected_tables": [[["Header A", "Header B"], ["1", "2"]]],
      "checks": {
        "min_pages": 1,
        "min_chars": 100,
        "min_tables": 1,
        "require_page_markers": true,
        "require_table_markdown": true,
        "require_multi_column_check": false,
        "require_captions_for_images": false
      }
    }
  ]
}
